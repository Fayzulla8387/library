rules_version = '2';

// =========================================================
//  KITOB-AYLANMA — Firestore xavfsizlik qoidalari
//  Firebase Console -> Firestore Database -> Rules bo'limiga
//  shu faylning butun matnini joylashtiring -> Publish
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------
    // PROFILES — foydalanuvchi profili (ism, telefon, telegram)
    // ---------------------------------------------------
    match /profiles/{userId} {
      // Har kim profillarni o'qiy oladi (kitob egasining kontaktini ko'rsatish uchun kerak)
      allow read: if true;
      // Faqat o'zi uchun (o'z uid'i bilan) profil yaratishi mumkin
      allow create: if request.auth != null && request.auth.uid == userId;
      // Faqat o'z profilini tahrirlashi mumkin
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---------------------------------------------------
    // BOOKS — e'lon qilingan kitoblar
    // ---------------------------------------------------
    match /books/{bookId} {
      // Barcha e'lonlarni hamma o'qiy oladi (tizimga kirmaganlar ham)
      allow read: if true;
      // Faqat tizimga kirgan foydalanuvchi, faqat o'z nomidan e'lon qo'sha oladi
      allow create: if request.auth != null
                    && request.resource.data.owner_id == request.auth.uid;
      // Faqat egasi o'z e'lonini tahrirlashi/o'chirishi mumkin
      allow update, delete: if request.auth != null
                    && resource.data.owner_id == request.auth.uid;
    }

    // ---------------------------------------------------
    // REQUESTS — kitobga yuborilgan so'rovlar
    // ---------------------------------------------------
    match /requests/{requestId} {
      // Faqat so'rov yuborgan yoki kitob egasi shu so'rovni o'qiy oladi
      allow read: if request.auth != null
                  && (resource.data.requester_id == request.auth.uid
                      || resource.data.owner_id == request.auth.uid);
      // Faqat tizimga kirgan foydalanuvchi, faqat o'z nomidan so'rov yuboradi
      allow create: if request.auth != null
                    && request.resource.data.requester_id == request.auth.uid;
      // Kitob egasi so'rov holatini yangilashi mumkin (masalan "ko'rildi")
      allow update: if request.auth != null
                    && resource.data.owner_id == request.auth.uid;
      allow delete: if false;
    }
  }
}
